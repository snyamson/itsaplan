{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/pro": "./src/schema/pro.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:pro": "drizzle-kit generate --config=drizzle.pro.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "test": "bun test --env-file=../../.env.test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/mailer": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/bun": "latest",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "typescript": "^6.0.3"
  }
}
